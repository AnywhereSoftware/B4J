@EndOfDesignText@
'Non-UI application (console / server application)
#Region Project Attributes 
	#CommandLineArgs: 
	#MergeLibraries: True 
#End Region
#CommandLineArgs: packager.json
Sub Process_Globals
	
End Sub

Sub AppStart (Args() As String)
	Start (Args)
	StartMessageLoop
End Sub

Private Sub Start (Args() As String) 
	Dim p As Packager
	p.Initialize
	Wait For (p.Run(Args)) Complete (Success As Boolean)
	If Success Then
		ExitApplication2(0)
	Else
		ExitApplication2(-1)
	End If
End Sub

Public Sub MyLog(s As String)
	Log(s)
End Sub

